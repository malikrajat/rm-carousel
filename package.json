  "typings": "types/rm-carousel.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./types/rm-carousel.d.ts",
      "default": "./fesm2022/rm-carousel.mjs"
